      "updated": 1789453505270,
      "link": null,
      "locked": false,
      "fontSize": 13,
      "fontFamily": 1,
      "text": "Prior price must be shown (lowest price in previous 30 days)  |  sponsored listings must be labelled  |  search ranking cannot be manipulated  |  best-before, return, refund,\nwarranty, delivery and payment details mandatory  |  dark pattern guidelines binding + yearly self-audit certificate  |  National Consumer Helpline linkage  |  consent for data use",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Prior price must be shown (lowest price in previous 30 days)  |  sponsored listings must be labelled  |  search ranking cannot be manipulated  |  best-before, return, refund,\nwarranty, delivery and payment details mandatory  |  dark pattern guidelines binding + yearly self-audit certificate  |  National Consumer Helpline linkage  |  consent for data use",
