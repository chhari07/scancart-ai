# ScanCart.ai backend — copy to .env and fill in. Never commit .env.
PORT=4000

# Claude — without this the checks run on backup rules only (no AI answers)
ANTHROPIC_API_KEY=
# Optional: defaults to claude-haiku-5-5 (fast). claude-sonnet-5-5 = slower, deeper.
ANTHROPIC_MODEL=

# Firebase Admin — either put serviceAccountKey.json in services/, or set these three
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Keep the quotes; \n stays as literal backslash-n
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Extra website origin allowed by CORS (scancart.ai and the Netlify site are built in)
FRONTEND_URL=

# Limits (defaults shown)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AGENT_TIMEOUT=10000
ALTERNATIVES_TIMEOUT=30000
